{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/expert-intelligence/expert-profile.schema.json",
  "title": "Expert Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "human_owner",
    "reviewed_at",
    "corpus_sources",
    "signal",
    "frameworks",
    "boundaries"
  ],
  "properties": {
    "human_owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "corpus_sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signal": {
      "type": "string",
      "minLength": 1
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "observations",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "cross_domain_edge": {
      "type": "string"
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
